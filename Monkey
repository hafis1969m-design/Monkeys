-- ฟังก์ชันค้นหาจุดขายสินค้า
local function getSellPart()
   for _, name in ipairs({"Sell", "Recycle", "Shop", "Deposit"}) do
      local part = Workspace:FindFirstChild(name, true)
      if part then
         return part:IsA("BasePart") and part or part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
      end
   end
   return nil
end

-- 🔍 ค้นหาไอเทมเป้าหมายที่อยู่ไกลที่สุด
local function getFarthestTarget()
   local target, farthest = nil, -math.huge
   local character = LocalPlayer.Character
   if not (character and character:FindFirstChild("HumanoidRootPart")) then return nil end
   local myPos = character.HumanoidRootPart.Position

   for _, obj in ipairs(Workspace:GetDescendants()) do
      if obj.Name:upper():find(selectedItem) then
         local part = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
         if part then
            local dist = (myPos - part.Position).Magnitude
            if dist > farthest then
               farthest = dist
               target = part
            end
         end
      end
   end
   return target
end

-- อัปเดตข้อมูลเรดาร์ Real-time
RunService.RenderStepped:Connect(function()
   if _G.RadarUI and RadarGui.Enabled then
      local target = getFarthestTarget()
      local character = LocalPlayer.Character
      if target and character and character:FindFirstChild("HumanoidRootPart") then
         local distance = math.floor((character.HumanoidRootPart.Position - target.Position).Magnitude)
         local tier = ItemTiers[selectedItem] or 1
         RadarInfo.Text = "🎯 เป้าหมาย: " .. selectedItem .. " (Tier: " .. tier .. ")\n📍 โซน: " .. tostring(target.Parent.Name) .. "\n📏 ระยะ: " .. distance .. " ม."
      else
         RadarInfo.Text = "❌ ไม่พบ " .. selectedItem
      end
   end
end)

-- RGB ESP Loop
task.spawn(function()
   local hue = 0
   while true do
      task.wait(0.1)
      hue = (hue + 0.03) % 1
      if _G.RGB_ESP then
         for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "RGB_Highlight" and obj:IsA("Highlight") then
               obj.FillColor = Color3.fromHSV(hue, 1, 1)
               obj.OutlineColor = Color3.fromHSV(hue, 1, 1)
            end
         end
      end
   end
end)

-- ฟังก์ชันขายไอเทม
local function sellItems()
   pcall(function()
      local character = LocalPlayer.Character
      if not (character and character:FindFirstChild("HumanoidRootPart")) then return end
      local sellPart = getSellPart()
      if sellPart then
         character.HumanoidRootPart.CFrame = sellPart.CFrame + Vector3.new(0, 3, 0)
         task.wait(0.1)
      end
      for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
         if remote.Name:lower():find("sell") or remote.Name:lower():find("recycle") then
            if remote:IsA("RemoteEvent") then
               remote:FireServer()
            elseif remote:IsA("RemoteFunction") then
               remote:InvokeServer()
            end
         end
      end
   end)
end

